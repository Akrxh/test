{
  "rules": {
    ".read": false,
    ".write": false,
    "sessions": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && (!newData.exists() || root.child('codes').child(newData.child('code').val()).exists())",
        "code": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}$/)" }
      }
    },
    "adminSessions": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && (!newData.exists() || newData.val() === root.child('adminKey').val())"
      }
    },
    "codes": {
      ".read": "auth != null && root.child('adminSessions').child(auth.uid).exists()",
      ".write": "auth != null && root.child('adminSessions').child(auth.uid).exists()",
      "$code": {
        ".read": "auth != null && root.child('sessions').child(auth.uid).child('code').val() === $code",
        ".validate": "$code.matches(/^[0-9]{4}$/) && newData.isString()"
      }
    },
    "students": {
      ".read": "auth != null && (root.child('sessions').child(auth.uid).exists() || root.child('adminSessions').child(auth.uid).exists())",
      "$sid": {
        ".write": "auth != null && (root.child('adminSessions').child(auth.uid).exists() || (root.child('sessions').child(auth.uid).child('code').exists() && root.child('codes').child(root.child('sessions').child(auth.uid).child('code').val()).val() === $sid))",
        ".validate": "!newData.exists() || newData.hasChildren(['name','status','cycle'])",
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24 && (!data.exists() || data.val() === newData.val() || root.child('adminSessions').child(auth.uid).exists())" },
        "status": { ".validate": "newData.val() === 'going' || newData.val() === 'pending' || newData.val() === 'out'" },
        "cycle": { ".validate": "newData.isString() && newData.val().length <= 10" },
        "$other": { ".validate": false }
      }
    }
  }
}
